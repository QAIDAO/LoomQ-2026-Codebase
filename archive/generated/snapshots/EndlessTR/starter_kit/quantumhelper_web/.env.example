# Copy this file to .env in the same directory for restart-safe local startup.
# .env is server-only and ignored by Git. Environment variables override it.
# Set to 1 only when the deployment has a protected LLM quota.
QUANTUMHELPER_ENABLE_LLM=0
LOOMQ_LLM_BASE_URL=
LOOMQ_LLM_API_KEY=
LOOMQ_LLM_MODEL=
LOOMQ_LLM_TIMEOUT_SECONDS=120
