# Local secrets for LoomQ cloud backends / L2 LLM. Never commit this file.
# Copy to `.env` and fill in values, or export them in your shell.

# Origin Quantum (本源) — from https://console.originqc.com.cn/zh/apikey
LOOMQ_ORIGINQ_API_KEY=

# local (default) | wukong
LOOMQ_ORIGINQ_MODE=local

# Optional poll timeout for async Wukong jobs (seconds)
LOOMQ_ORIGINQ_TIMEOUT_SEC=1800

# SpinQ Cloud (量旋) — register SSH public key on https://cloud.spinq.cn
# local (default) | cloud
LOOMQ_SPINQ_MODE=local
LOOMQ_SPINQ_USERNAME=
LOOMQ_SPINQ_KEYFILE=
# Optional: gemini_vp (2q NMR) | triangulum_vp (3q) | superconductor_vp (8q)
LOOMQ_SPINQ_PLATFORM=gemini_vp
# LOOMQ_SPINQ_HOST=
# LOOMQ_SPINQ_TASK_NAME=loomq-bell
# LOOMQ_SPINQ_TASK_DESC=LoomQ hardware evidence

# L2 OpenAI-compatible model (required for agent_chat / official L2 scoring)
# Example DeepSeek: BASE_URL=https://api.deepseek.com/v1  MODEL=deepseek-chat
LOOMQ_LLM_BASE_URL=
LOOMQ_LLM_API_KEY=
LOOMQ_LLM_MODEL=
# Optional overrides (defaults match l2_policy.json)
# LOOMQ_LLM_TIMEOUT_SECONDS=120
# LOOMQ_LLM_MAX_OUTPUT_TOKENS=2000
