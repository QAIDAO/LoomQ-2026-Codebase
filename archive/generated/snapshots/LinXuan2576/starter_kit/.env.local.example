# LoomQ L2 本地调试配置模板
#
# 用法:复制本文件为 .env.local,填入真实值(l2_agent 启动时自动读取)。
# 正式评测时组委会注入 LOOMQ_LLM_*,不需要此文件(且注入值优先)。
#
# ⚠️ 密钥安全:
#   - 真实 key 只写进 .env.local(已被 .gitignore 忽略,不会进仓库)
#   - 绝不把真实 key 写进代码、对话、截图、邮件、文档
#   - 本模板(.env.local.example)可安全提交,只含占位符

LOOMQ_LLM_BASE_URL=https://api.deepseek.com
LOOMQ_LLM_API_KEY=sk-在这里填你的key
LOOMQ_LLM_MODEL=deepseek-chat
