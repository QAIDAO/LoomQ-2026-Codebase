# 把这个文件复制成 .env，填上你自己的服务和密钥。
#   cp .env.example .env
#
# .env 已经在 .gitignore 里，不会被提交。
#
# 这里刻意**不写任何真实的服务地址或模型名**当例子。赛题的硬性要求是
# 源码不得硬编码 API 地址、密钥或模型名称，而"给个真实例子方便填"
# 恰好是最容易破这条规矩的地方——CLI 的帮助文字就这么破过一次，
# 一边写着示例地址，一边在下一行声明"本程序不硬编码任何服务地址"。
# 换成任何 OpenAI 协议的服务都不用改代码，这里也就没有必要偏袒某一家。

# 模型服务（L2 智能体与交互入口需要）
LOOMQ_LLM_BASE_URL=<你的服务地址，形如 https://.../v1>
LOOMQ_LLM_API_KEY=<你的密钥>
LOOMQ_LLM_MODEL=<你的模型名>

# 本源量子云真机（只有 tools/run_on_hardware.py 会用；自动评测不需要）
# 在本源量子云个人中心申请 API Token 后填在这里。
LOOMQ_ORIGINQ_TOKEN=<你的 Token>

# 量旋云真机（只有 tools/run_on_spinq.py 会用）
# 量旋用「用户名 + RSA 私钥」登录，不是 API Token。
# 私钥文件请留在仓库外，这里只写路径。
LOOMQ_SPINQ_USERNAME=<你的量旋用户名>
LOOMQ_SPINQ_KEYFILE=<私钥文件路径，例如 ~/.spinq_key>
