# Copy the required values into your shell environment. Do not rename this
# file to a tracked path containing real credentials, and keep private keys
# outside the repository.

# SpinQ Cloud / SpinQit 0.2.4. Username and private-key path are required.
SPINQ_CLOUD_USERNAME=
SPINQ_CLOUD_KEY_FILE=D:\path\outside\repo\spinq-private-key.pem
# Optional routing overrides. Empty values use SpinQit's service default and
# the three-qubit triangulum_vp hardware platform.
SPINQ_CLOUD_HOST=
SPINQ_CLOUD_PLATFORM=

# OriginQ QCloud / pyqpanda3 0.4.0. The backend name may be WK_C180.
# When using Docker --env-file, do not wrap values in quotes.
LOOMQ_ORIGINQ_TOKEN=
LOOMQ_ORIGINQ_CHIP_ID=

# Optional OriginQ overrides. An empty URL uses the project's forced HTTPS URL
# https://pyqanda-admin.qpanda.cn rather than the SDK's plaintext HTTP default.
LOOMQ_ORIGINQ_QCLOUD_URL=
LOOMQ_ORIGINQ_POLL_INTERVAL_SECONDS=5
LOOMQ_ORIGINQ_JOB_TIMEOUT_SECONDS=1800
LOOMQ_ORIGINQ_IS_AMEND=true
LOOMQ_ORIGINQ_IS_MAPPING=true
LOOMQ_ORIGINQ_IS_OPTIMIZATION=true

# AWS Braket QPU fallback. Store credentials only in the named AWS profile;
# never put AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY in this file.
LOOMQ_BRAKET_AWS_PROFILE=
LOOMQ_BRAKET_AWS_REGION=
LOOMQ_BRAKET_DEVICE_ARN=
LOOMQ_BRAKET_S3_BUCKET=
LOOMQ_BRAKET_S3_PREFIX=loomq/l1
LOOMQ_BRAKET_POLL_INTERVAL_SECONDS=5
LOOMQ_BRAKET_JOB_TIMEOUT_SECONDS=432000
