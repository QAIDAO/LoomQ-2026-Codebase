# LoomQ 环境变量模板
# 复制为 .env 并按需填写；.env 已被 gitignore，切勿提交真实密钥/Token。
# 加载：set -a; source .env; set +a
#
# 正式评测会由组委会统一注入 DeepSeek 模型服务（LOOMQ_LLM_*），
# 本地配置仅用于开发调试，不影响评测结果。

# ---- L2 大模型（本地调试用；正式评测由组委会注入 DeepSeek）----
# 方案 A：本地 Ollama（免费，无需申请）
#   LOOMQ_LLM_BASE_URL=http://localhost:11434/v1
#   LOOMQ_LLM_API_KEY=ollama
#   LOOMQ_LLM_MODEL=gemma4
# 方案 B：DeepSeek（与正式评测同源，仅调试）
LOOMQ_LLM_BASE_URL=https://api.deepseek.com
LOOMQ_LLM_API_KEY=<你的 DeepSeek API Key>
LOOMQ_LLM_MODEL=deepseek-v4-flash
LOOMQ_LLM_TIMEOUT_SECONDS=120

# ---- L1 真机 · SpinQ Cloud（可选，+5 分）----
# 本地生成 RSA 密钥对，把公钥上传到 cloud.spinq.cn（个人中心 → SSH 密钥管理）：
#   openssl genrsa -out ~/.spinq/spinq_rsa 2048
#   ssh-keygen -y -f ~/.spinq/spinq_rsa > ~/.spinq/spinq_rsa.pub   # 公钥内容上传网站
LOOMQ_SPINQ_USERNAME=<你的 SpinQ 云用户名>
LOOMQ_SPINQ_KEYFILE=~/.spinq/spinq_rsa
# LOOMQ_SPINQ_HOST=http://cloud.spinq.cn:6060
# LOOMQ_SPINQ_PLATFORM=gemini_vp        # bell 默认 gemini_vp(2q) / ghz3 默认 triangulum_vp(3q)
# LOOMQ_SPINQ_SHOTS=1024

# ---- L1 真机 · 本源量子云 悟空芯（可选，第二平台 +5 分，免费额度）----
# 注册 http://qcloud.originqc.com.cn → 个人中心申请 API Token
LOOMQ_ORIGINQ_TOKEN=<你的本源 API Token>
# LOOMQ_ORIGINQ_CHIP=72        # 悟空芯 72 比特（real_chip_wukong_72）
# LOOMQ_ORIGINQ_SHOTS=1024